---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationCard from '../components/PublicationCard.astro';
import BlueskyPost from '../components/BlueskyPost.astro';
import SocialIcons from '../components/SocialIcons.astro';
import TissueCanvas from '../components/TissueCanvas.astro';
import { getCollection, render } from 'astro:content';
import {
  getSortedResearch,
  getFeaturedPublications,
  getBlueskyPosts,
} from '../lib/content';
import { site } from '../data/site';

const [bioEntry] = await getCollection('bio');
const { Content: BioContent } = await render(bioEntry);

const research = await getSortedResearch();
const featuredPubs = getFeaturedPublications();
const bluesky = getBlueskyPosts(3);
---

<BaseLayout title={site.name}>
  <section class="hero">
    <TissueCanvas mode="hero" />
    <div class="hero-veil"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow hero-eyebrow">Tumour cell states · plasticity · single-cell · spatial</p>
        <h1>{site.name}</h1>
        <p class="hero-role">{site.role} at {site.institution}</p>
        <p class="hero-standfirst">
          I study how tumour cells move between states, and what shapes that plasticity within the
          tissue around them.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/research">Explore the research</a>
          <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="btn" href={site.cvPdf} download>Download CV ↓</a>
        </div>
        <SocialIcons class="hero-socials" />
      </div>
    </div>
    <div class="hero-legend" aria-hidden="true">
      <span>Move your cursor over the tissue to perturb cell states</span>
      <span class="legend-key">
        <i style="background: var(--state-1)"></i><i style="background: var(--state-2)"></i><i style="background: var(--state-3)"></i><i style="background: var(--state-4)"></i>
        Cell states
      </span>
    </div>
  </section>

  <section class="bio-section">
    <div class="container">
      <div class="prose bio-prose">
        <BioContent />
      </div>
    </div>
  </section>

  <section class="research-teaser">
    <div class="container">
      <SectionHeading eyebrow="Research" title="What I work on" />
      <ul class="theme-pills">
        {
          research.map((theme) => (
            <li>
              <a href={`/research#${theme.id}`}>{theme.data.title}</a>
            </li>
          ))
        }
      </ul>
      <a class="text-link" href="/research">Explore the research programme →</a>
    </div>
  </section>

  <section class="pubs-teaser">
    <div class="container">
      <SectionHeading eyebrow="Publications" title="Selected publications" />
      <div class="pub-list">
        {featuredPubs.map((pub) => <PublicationCard pub={pub} compact />)}
      </div>
      <a class="text-link" href="/publications">View all publications →</a>
    </div>
  </section>

  <section class="bluesky-teaser">
    <div class="container">
      <SectionHeading eyebrow="Elsewhere" title="Latest from Bluesky" />
      {
        bluesky.ok ? (
          <div class="bsky-grid card-grid">
            {bluesky.posts.map((post) => (
              <div class="card">
                <BlueskyPost post={post} />
              </div>
            ))}
          </div>
        ) : (
          <p class="bsky-fallback">
            Couldn't load recent posts right now — you can find the latest updates directly on
            {' '}
            <a href={`https://bsky.app/profile/${site.bluesky.handle}`}>Bluesky</a>.
          </p>
        )
      }
      <a class="text-link" href={`https://bsky.app/profile/${site.bluesky.handle}`} target="_blank" rel="noopener noreferrer">
        View more on Bluesky →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 0;
    min-height: min(46rem, calc(100svh - 4.5rem));
    display: flex;
    align-items: center;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 82%, transparent) 34%,
      transparent 62%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-9);
    pointer-events: none;
  }

  .hero-text {
    max-width: 34rem;
    pointer-events: auto;
  }

  .hero-eyebrow {
    color: var(--color-accent);
    letter-spacing: 0.14em;
    margin-bottom: var(--space-4);
  }

  .hero-text h1 {
    margin-bottom: var(--space-2);
  }

  .hero-role {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .hero-standfirst {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--color-text);
    max-width: 30rem;
    line-height: var(--leading-relaxed);
  }

  .hero-legend {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-4);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    text-align: right;
    pointer-events: none;
  }

  .legend-key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-key i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }

  .bio-section {
    padding-top: 0;
  }

  .theme-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .theme-pills a {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 500;
    padding: 0.55em 1em;
    border-radius: 999px;
    border: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease);
  }

  .theme-pills a:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    background: var(--color-bg-hover);
  }

  .text-link {
    display: inline-block;
    margin-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .pub-list {
    max-width: var(--measure-wide);
  }

  .bio-prose {
    max-width: var(--measure-wide);
  }

  .bsky-grid {
    margin-bottom: var(--space-2);
  }

  .bsky-fallback {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 640px) {
    .hero {
      align-items: flex-start;
      min-height: 0;
    }

    .hero-inner {
      /* reserve the lower part of the hero for the tissue */
      padding-block: var(--space-7) 25rem;
    }

    .hero-veil {
      display: none;
    }

  }
</style>
