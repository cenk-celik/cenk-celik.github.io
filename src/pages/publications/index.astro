---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getPublications } from '../../lib/content';

const publications = getPublications().filter((pub) => pub.type !== 'abstract' && pub.type !== 'protocol');
---

<BaseLayout title="Publications" description="Journal articles, reviews, book chapters and preprints, sorted by year.">
  <section>
    <div class="container">
      <SectionHeading title="Publications" />

      <p class="scholar-link">
        <a href="https://scholar.google.com/citations?user=zidMl6YAAAAJ" target="_blank" rel="noopener noreferrer">
          Full profile, with citation counts, on Google Scholar ↗
        </a>
      </p>

      <div class="pub-list">
        {publications.map((pub) => <PublicationCard pub={pub} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .scholar-link {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    margin-bottom: var(--space-8);
  }

  .scholar-link a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .scholar-link a:hover {
    text-decoration: underline;
  }
</style>
