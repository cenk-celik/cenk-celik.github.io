---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getPublications, getPublicationMetrics, formatMonthYear } from '../../lib/content';

const publications = getPublications();
const metrics = getPublicationMetrics();

const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  const list = byYear.get(pub.year) ?? [];
  list.push(pub);
  byYear.set(pub.year, list);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Publications" description="Journal articles, reviews, book chapters and preprints, sorted by year.">
  <section>
    <div class="container">
      <SectionHeading eyebrow="Publications" title="Publications" />

      <div class="metrics-row">
        <div class="metric">
          <span class="metric-value">{metrics.citations}</span>
          <span class="metric-label">Citations</span>
        </div>
        <div class="metric">
          <span class="metric-value">{metrics.hIndex}</span>
          <span class="metric-label">h-index</span>
        </div>
        <div class="metric">
          <span class="metric-value">{metrics.i10Index}</span>
          <span class="metric-label">i10-index</span>
        </div>
        <a class="metric metric-link" href="https://scholar.google.com/citations?user=zidMl6YAAAAJ" target="_blank" rel="noopener noreferrer">
          Google Scholar profile ↗
        </a>
      </div>
      <p class="metrics-note">
        Synced automatically from Google Scholar · last checked {formatMonthYear(new Date(metrics.updated))}
      </p>

      {
        years.map((year) => (
          <div class="year-group">
            <h2 class="year-heading">{year}</h2>
            <div class="pub-list">
              {byYear.get(year)!.map((pub) => <PublicationCard pub={pub} />)}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-7);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .metric {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    color: var(--color-text);
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .metric-link {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .metric-link:hover {
    text-decoration: underline;
  }

  .metrics-note {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-faint);
    margin-bottom: var(--space-8);
  }

  .year-heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0;
  }

  .year-group + .year-group {
    margin-top: var(--space-6);
  }

  @media (max-width: 640px) {
    .metrics-row {
      gap: var(--space-5);
    }

    .metric-link {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
