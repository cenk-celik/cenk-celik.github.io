---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getPublications, getPublicationMetrics, formatMonthYear } from '../../lib/content';

const publications = getPublications().filter((pub) => pub.type !== 'abstract' && pub.type !== 'protocol');
const metrics = getPublicationMetrics();
---

<BaseLayout title="Publications" description="Journal articles, reviews, book chapters and preprints, sorted by year.">
  <section>
    <div class="container">
      <SectionHeading title="Publications" />

      <div class="metrics-row">
        <div class="metric">
          <span class="metric-value">{metrics.citations}</span>
          <span class="metric-label">Citations</span>
        </div>
        <div class="metric">
          <span class="metric-value">{metrics.hIndex}</span>
          <span class="metric-label">h-index</span>
        </div>
        <div class="metric">
          <span class="metric-value">{metrics.i10Index}</span>
          <span class="metric-label">i10-index</span>
        </div>
        <a class="metric metric-link" href="https://scholar.google.com/citations?user=zidMl6YAAAAJ" target="_blank" rel="noopener noreferrer">
          Google Scholar profile ↗
        </a>
      </div>
      <p class="metrics-note">
        Last updated {formatMonthYear(new Date(metrics.updated))}
      </p>

      <div class="pub-list">
        {publications.map((pub) => <PublicationCard pub={pub} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-7);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .metric {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    color: var(--color-text);
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .metric-link {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .metric-link:hover {
    text-decoration: underline;
  }

  .metrics-note {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-faint);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 640px) {
    .metrics-row {
      gap: var(--space-5);
    }

    .metric-link {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
