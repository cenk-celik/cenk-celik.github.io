---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <p class="footer-name">{site.name}</p>
      <p class="footer-meta">{site.role} · {site.institution}</p>
      <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <div class="footer-col footer-col-end">
      <SocialIcons />
      <p class="footer-copy">© {year} {site.name}. Built with <a href="https://astro.build">Astro</a>, hosted on GitHub Pages.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    padding-block: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    margin: 0;
  }

  .footer-meta {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    margin: var(--space-1) 0 var(--space-2);
  }

  .footer-email {
    font-size: var(--step--1);
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .footer-col-end {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
    text-align: right;
  }

  .footer-copy {
    font-size: var(--step--1);
    color: var(--color-text-faint);
    margin: 0;
  }

  .footer-copy a {
    color: var(--color-text-faint);
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .footer-col-end {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
